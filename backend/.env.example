
# Pinata credentials
PINATA_JWT=your_pinata_jwt_here

# Optional: your dedicated Pinata gateway hostname
PINATA_GATEWAY=

# Maximum certificate PDF upload size: 10 MB
MAX_UPLOAD_SIZE=10485760

# Local Hardhat blockchain RPC
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# CertificateRegistry contract address
CONTRACT_ADDRESS=0xa513E6E4b8f2a923D98304ec87F64353C4D5C853

# Authorized institution wallet address
ISSUER_ADDRESS=your_institution_wallet_address
